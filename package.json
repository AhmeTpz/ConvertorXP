{
  "name": "convertor-xp",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build": "node build.mjs",
    "format": "prettier --write \"*.{js,mjs,html,css}\" \"native/**/*.{mjs,cjs}\" \"shared/**/*.js\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\"",
    "check": "node --check app.js && node --check desktop.js && node --check windows.js && node --check viewers.js && node --check editor.js && node --check image-engine.js && node --check file-utils.js && node --check i18n.js",
    "test": "node --test tests/*.test.mjs",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && npm run licenses && electron-builder --win nsis --x64",
    "test:e2e": "npm run build && node tests/e2e/stage1.e2e.mjs && node tests/e2e/stage2.e2e.mjs",
    "test:e2e:stage2": "npm run build && node tests/e2e/stage2.e2e.mjs",
    "test:e2e:exe": "node tests/e2e/stage1.e2e.mjs --exe",
    "check:native": "node scripts/check-native.mjs",
    "test:desktop": "electron scripts/test-desktop.mjs",
    "test:matrix": "node scripts/verify-matrix.mjs",
    "licenses": "node scripts/licenses.mjs",
    "prepare:engines": "node scripts/fetch-engines.mjs && node scripts/bundle-engines.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "@pdf-lib/fontkit": "^1.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "7zip-bin": "^5.2.0",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "iconv-lite": "^0.7.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "tesseract.js": "^7.0.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10"
  },
  "description": "Yerel dosya masaüstü ve dönüştürme araçları",
  "author": "ConvertorXP contributors",
  "license": "GPL-3.0-or-later",
  "main": "native/main.mjs",
  "build": {
    "appId": "org.convertorxp.desktop",
    "productName": "ConvertorXP",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "native/**/*",
      "shared/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "packages.json",
          "fonts/**/*",
          "policy/**/*",
          "engines/**/*",
          "licenses/**/*",
          "THIRD-PARTY.md"
        ]
      }
    ],
    "asarUnpack": [
      "**/*.node",
      "**/7zip-bin/**",
      "**/tesseract.js-core/**",
      "**/pdfjs-dist/**"
    ],
    "win": {
      "target": "nsis",
      "signExecutable": false,
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    }
  }
}
